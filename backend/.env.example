# ClearCut AI Backend Environment Configuration Example
APP_NAME="ClearCut AI - Background Remover API"
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8001

# CORS Allowed Origins (JSON array of allowed frontend URLs)
CORS_ORIGINS=["http://localhost:5174", "http://127.0.0.1:5174", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# File & Image Resource Limits
MAX_FILE_SIZE_BYTES=15728640  # 15 MB
MAX_IMAGE_PIXELS=25000000    # 25 MP (e.g. 5000x5000)
MAX_IMAGE_DIMENSION=6000

# AI Model Selection
# Options:
# - u2net: Default high quality foreground segmentation (~176 MB)
# - u2netp: Ultra-lightweight model for low memory / VPS (~4.5 MB)
# - isnet-general-use: High-accuracy alternative (~174 MB)
MODEL_NAME=u2net

# Concurrency Control (Maximum parallel AI inferences to prevent CPU/RAM exhaustion)
MAX_CONCURRENT_INFERENCES=2

# Rate Limiting (Requests allowed per client IP)
RATE_LIMIT_PER_MINUTE=30/minute
